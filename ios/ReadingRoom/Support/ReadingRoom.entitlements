<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Debug/dev builds use the APNs sandbox;
	     Release/archive builds override this to "production" via project.yml so
	     the App Store build talks to the production APNs gateway. Requires the
	     Push Notifications capability enabled on the App ID in the Apple
	     Developer portal for real delivery. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
